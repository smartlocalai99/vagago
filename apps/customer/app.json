{
  "expo": {
    "name": "VagaGo",
    "slug": "vagago-customer",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vagago.customer",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vagago.customer",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#183E34"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "VagaGo — stays in Vagamon",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#073728"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow VagaGo to use Face ID to keep your profile and bookings private."
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "vagago",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "83cb1bae-c335-4d8d-ab03-f227c3147b4b"
      }
    },
    "owner": "vardhanreddy",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/83cb1bae-c335-4d8d-ab03-f227c3147b4b"
    }
  }
}
